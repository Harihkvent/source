flowchart TB
    %% System Design Diagram for Practical Career Navigator

    %% User Interface Layer
    UI["Streamlit UI / React"]
    
    %% Application Layer
    API["FastAPI Backend"]
    
    %% Core Components
    RP["Resume Parser"]
    JR["Job Recommender"] 
    RG["Roadmap Generator"]
    
    %% Data Layer
    DB[("Database<br/>(SQLite)")]
    
    %% External Components
    OCR["OCR Engine<br/>(pytesseract)"]
    NLP["NLP Processing<br/>(spaCy)"]
    ML["ML Models<br/>(scikit-learn)"]
    
    %% Connections
    UI <-->|"HTTP Requests"| API
    API --> RP
    API --> JR
    API --> RG
    API <-->|"Store/Retrieve Data"| DB
    
    RP -->|"Process Documents"| OCR
    RP -->|"Extract Entities"| NLP
    JR -->|"Score & Rank"| ML
    
    %% Styling
    classDef ui fill:#a7c7e7,stroke:#333,color:#000
    classDef api fill:#ffda9e,stroke:#333,color:#000
    classDef core fill:#c8e6c9,stroke:#333,color:#000
    classDef data fill:#ffccbc,stroke:#333,color:#000
    classDef external fill:#d1c4e9,stroke:#333,color:#000
    
    class UI ui
    class API api
    class RP,JR,RG core
    class DB data
    class OCR,NLP,ML external